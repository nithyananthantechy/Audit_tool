# Application Environment Variables Template
# Copy this file to .env or .env.production and provide real values securely via your secrets manager or hosting environment.

NODE_ENV=production
PORT=3001

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:3001

# Database Configuration (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# Email/SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Security & Encryption (Hex-encoded 32-byte string for AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=
SESSION_SECRET=

# Allowed CORS Origins (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

# AI Intelligence API
GEMINI_API_KEY=
